# ---- External services ----
FACTCHECK_API_KEY=                 # Google Fact Check Tools API key
TRANSLATION_PROVIDER=none          # indictrans2 | hosted | none
TRANSLATION_BASE=                  # used when provider=hosted
TRANSLATION_API_KEY=               # used when provider=hosted

# ---- Storage ----
DB_PATH=./data/verity.db
INDEX_DIR=./data/index

# ---- Tunables (INITIAL values; tuned in T5.4 / T8.3, then frozen) ----
VERDICT_THRESHOLD=0.75             # TRD §7 starting value
RETRIEVAL_TOP_K=5                  # TRD §5
FACTCHECK_MATCH_THRESHOLD=0.40     # swept on held-out published fact-checks (see README)
HEADLINE_MATCH_THRESHOLD=0.40      # at 0.30, 8% of debunked claims matched an unrelated headline; 1.5% at 0.40
TONE_THRESHOLD=0.50                # initial guess, tuned on dev set
MAX_MESSAGE_CHARS=5000
RANDOM_SEED=42
LIKELIHOOD_WEIGHTING_SAMPLES=5000
SIMHASH_MAX_HAMMING=12             # D2, swept on held-out published fact-checks
LOOKALIKE_MAX_EDIT=2               # D3
LOOKALIKE_MIN_LEN=6                # D3, trusted domains shorter than this are exact-match only
RADAR_MIN_COUNT=3                  # D5, minimum checks before a family is shown
RADAR_WINDOW_HOURS=24              # D5

# ---- Services ----
API_BASE=http://localhost:8000
UI_PORT=8501
